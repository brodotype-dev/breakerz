{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=zucuzhtiitibsvryenpi"
    },
    "card-hedge": {
      "type": "http",
      "url": "https://api.cardhedger.com/mcp",
      "headers": {
        "X-API-Key": "${CARDHEDGER_API_KEY}"
      }
    },
    "resend": {
      "command": "npx",
      "args": ["-y", "resend-mcp"],
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}",
        "SENDER_EMAIL_ADDRESS": "hello@getbreakiq.com"
      }
    },
    "firecrawl": {
      "type": "http",
      "url": "https://mcp.firecrawl.dev/${FIRECRAWL_API_KEY}/v2/mcp"
    }
  }
}
